# Copy to .env (which git ignores) and fill in. Never commit the real file.
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-password
CORS_ORIGINS=http://localhost:8080
# Where the website lives (used in the links inside emails)
APP_URL=http://localhost:8080
# Real emails (verification + forgot password) via https://resend.com. Leave blank in development:
# the emails are then printed in this terminal instead.
EMAIL_API_KEY=
EMAIL_FROM=FitLibrary <noreply@your-domain.example>
# Make customers confirm their email before posting/downloading. Default: on when EMAIL_API_KEY is set, off otherwise.
# REQUIRE_EMAIL_VERIFICATION=true
